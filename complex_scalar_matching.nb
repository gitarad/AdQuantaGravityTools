Cell[BoxData[
 RowBox[{
  RowBox[{"IBPSimplify2", "[", 
   RowBox[{"expr_", ",", "varSym_", ",", "varSym2_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "beforeAnsatz", ",", "ansatz", ",", "EquationOfConstraint", ",", 
      "EquationOfConstraint2", ",", "ReducedEq", ",", "ReducedEq2", ",", 
      "eqs", ",", "rhsConstants", ",", "rhsSubstitutions", ",", 
      "ibpZeroOperator"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"beforeAnsatz", " ", "=", " ", 
      RowBox[{"List", "@@", 
       RowBox[{"(", 
        RowBox[{"expr", "//", "CollectTensors"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ansatz", "=", 
      RowBox[{"MakeAnsatz", "[", "beforeAnsatz", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"EquationOfConstraint", "=", 
      RowBox[{
       RowBox[{"VarD", "[", "varSym", "]"}], "[", "ansatz", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"EquationOfConstraint2", "=", 
      RowBox[{
       RowBox[{"VarD", "[", "varSym2", "]"}], "[", "ansatz", "]"}]}], ";", 
     "\n", "     ", 
     RowBox[{"ReducedEq", "=", 
      RowBox[{"CollectTensors", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"EquationOfConstraint", "//", "ScreenDollarIndices"}], "//",
            "ToCanonical"}], "//", "ContractMetric"}], "//", "SortCovDs"}], "//",
         "Simplify"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ReducedEq2", "=", 
      RowBox[{"CollectTensors", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"EquationOfConstraint2", "//", "ScreenDollarIndices"}], "//",
            "ToCanonical"}], "//", "ContractMetric"}], "//", "SortCovDs"}], "//",
         "Simplify"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqs", "=", 
      RowBox[{
       RowBox[{"SolveConstants", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ReducedEq", "==", "0"}], ",", 
           RowBox[{"ReducedEq2", "==", "0"}]}], "}"}], ",", 
         RowBox[{"!", 
          RowBox[{"{", 
           RowBox[{
           "hbar", ",", "hbar2", ",", "\[Kappa]", ",", "\[Kappa]2", ",", 
            "\[Epsilon]", ",", "M", ",", "\[Mu]bar2"}], "}"}]}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rhsConstants", "=", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"eq", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"s_Symbol", "/;", 
              RowBox[{"StringMatchQ", "[", 
               RowBox[{
                RowBox[{"SymbolName", "[", "s", "]"}], ",", 
                RowBox[{"\"\<C\>\"", "~~", 
                 RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], ",", 
             "Infinity"}], "]"}], "//", "DeleteDuplicates"}], ",", 
          RowBox[{"{", 
           RowBox[{"eq", ",", "eqs"}], "}"}]}], "]"}], "]"}], "//", 
       "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rhsSubstitutions", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Cnum", "->", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"Cnum", ",", "rhsConstants"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ibpZeroOperator", "=", 
      RowBox[{
       RowBox[{"ansatz", "/.", "eqs"}], "/.", "rhsSubstitutions"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ibpZeroOperator", "=", 
      RowBox[{"ibpZeroOperator", "/.", 
       RowBox[{
        RowBox[{"s_Symbol", "/;", 
         RowBox[{"StringMatchQ", "[", 
          RowBox[{
           RowBox[{"SymbolName", "[", "s", "]"}], ",", 
           RowBox[{"\"\<C\>\"", "~~", 
            RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], ":>", 
        RowBox[{"-", "1"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"expr", "+", "ibpZeroOperator"}], ")"}], "//", 
      "CollectTensors"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{
  3.9809317217559175`*^9, {3.980931963506832*^9, 3.980931988266707*^9}, {
   3.98093267455217*^9, 3.980932690961539*^9}, 3.980933339599673*^9},
