Cell[BoxData[{
 RowBox[{
  RowBox[{"perturbationSum", "[", 
   RowBox[{"expr_", ",", "order_", ",", "orderParam_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PerturbFlat", "[", 
      RowBox[{"expr", ",", "i"}], "]"}], 
     RowBox[{
      RowBox[{"orderParam", "^", "i"}], "/", 
      RowBox[{"Factorial", "[", "i", "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "order"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"perturbation", " ", "=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"ExpandPerturbation", "[", 
       RowBox[{"perturbationSum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"-", 
            RowBox[{"Detg", "[", "]"}]}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], 
             RowBox[{
              RowBox[{"CD", "[", 
               RowBox[{"-", "\[Alpha]"}], "]"}], "[", 
              RowBox[{"\[CapitalPhi]", "[", "]"}], "]"}], 
             RowBox[{
              RowBox[{"CD", "[", 
               RowBox[{"-", "\[Beta]"}], "]"}], "[", 
              RowBox[{"\[CapitalPhi]c", "[", "]"}], "]"}]}], "-", 
            RowBox[{
             RowBox[{"M", "^", "2"}], 
             RowBox[{"\[CapitalPhi]", "[", "]"}], 
             RowBox[{"\[CapitalPhi]c", "[", "]"}]}]}], ")"}]}], ",", "2", ",",
          "\[Kappa]"}], "]"}], "]"}], "//", "ToFlat"}], "//", 
     "CollectTensors"}], ")"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"-", 
        RowBox[{"Detg", "[", "]"}]}], "]"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"\[CapitalPhi]pert", "[", 
       RowBox[{"LI", "[", "n_", "]"}], "]"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"\[CapitalPhi]pertc", "[", 
       RowBox[{"LI", "[", "n_", "]"}], "]"}], "->", "0"}]}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"translatedPert", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"perturbation", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"CD", "[", "a_", "]"}], ":>", 
         RowBox[{"PD", "[", "a", "]"}]}], ",", 
        RowBox[{
         RowBox[{"H", "[", 
          RowBox[{
           RowBox[{"LI", "[", "order_", "]"}], ",", "a_", ",", "b_"}], "]"}], 
         ":>", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"order", "==", "1"}], ",", 
           RowBox[{"r", "[", 
            RowBox[{"a", ",", "b"}], "]"}], ",", "0"}], "]"}]}]}], "}"}]}], "/.",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"s_Symbol", "/;", 
         RowBox[{"StringMatchQ", "[", 
          RowBox[{
           RowBox[{"SymbolName", "[", "s", "]"}], ",", "\"\<\[Tau]*\>\""}], 
          "]"}]}], ":>", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"\"\<d\>\"", "<>", 
          RowBox[{"StringDrop", "[", 
           RowBox[{
            RowBox[{"SymbolName", "[", "s", "]"}], ",", "1"}], "]"}]}], 
         "]"}]}], ",", 
       RowBox[{"\[Alpha]", "->", "a"}], ",", 
       RowBox[{"\[Beta]", "->", "b"}], ",", 
       RowBox[{"\[Rho]", "->", "c"}], ",", 
       RowBox[{"\[Tau]", "->", "d"}], ",", 
       RowBox[{"\[CapitalPhi]", "->", "\[CurlyPhi]"}], ",", 
       RowBox[{"\[CapitalPhi]c", "->", "\[CurlyPhi]c"}]}], "}"}]}], "//", 
    "CollectTensors"}], "//", "ScreenDollarIndices"}]}]}], "Input",
