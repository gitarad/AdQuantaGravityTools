Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"translatePerturbation", "[", "pert_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"pert", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", "a_", "]"}], ":>", 
          RowBox[{"PD", "[", "a", "]"}]}], ",", 
         RowBox[{
          RowBox[{"H", "[", 
           RowBox[{
            RowBox[{"LI", "[", "order_", "]"}], ",", "a_", ",", "b_"}], "]"}],
           ":>", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"order", "==", "1"}], ",", 
            RowBox[{"r", "[", 
             RowBox[{"a", ",", "b"}], "]"}], ",", "0"}], "]"}]}]}], "}"}]}], "/.",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"s_Symbol", "/;", 
          RowBox[{"StringMatchQ", "[", 
           RowBox[{
            RowBox[{"SymbolName", "[", "s", "]"}], ",", "\"\<\[Tau]*\>\""}], 
           "]"}]}], ":>", 
         RowBox[{"ToExpression", "[", 
          RowBox[{"\"\<d\>\"", "<>", 
           RowBox[{"StringDrop", "[", 
            RowBox[{
             RowBox[{"SymbolName", "[", "s", "]"}], ",", "1"}], "]"}]}], 
          "]"}]}], ",", 
        RowBox[{"\[Alpha]", "->", "a"}], ",", 
        RowBox[{"\[Beta]", "->", "b"}], ",", 
        RowBox[{"\[Rho]", "->", "c"}], ",", 
        RowBox[{"\[Tau]", "->", "d"}]}], "}"}]}], "//", "CollectTensors"}], "//",
     "ScreenDollarIndices"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.982068626477823*^9, 3.982068649843256*^9}, 
   3.98222724373263*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"300fd73e-4107-554a-885c-baed84b0e139"],

