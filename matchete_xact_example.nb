Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"perturbationSum", "[", 
   RowBox[{"expr_", ",", "order_", ",", "orderParam_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PerturbFlat", "[", 
      RowBox[{"expr", ",", "i"}], "]"}], 
     RowBox[{"orderParam", "^", "i"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "order"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"perturbation", " ", "=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"ExpandPerturbation", "[", 
       RowBox[{"perturbationSum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"-", 
            RowBox[{"Detg", "[", "]"}]}], "]"}], 
          RowBox[{"RicciScalarCD", "[", "]"}]}], ",", "3", ",", "\[Kappa]"}], 
        "]"}], "]"}], "//", "ToFlat"}], "//", "CollectTensors"}], ")"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"-", 
       RowBox[{"Detg", "[", "]"}]}], "]"}], "->", "1"}], "}"}]}]}]}], "Input",\

 CellChangeTimes->{{3.9804908500734024`*^9, 3.980490851458084*^9}, {
