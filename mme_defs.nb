Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"IBPSimplify", "[", 
    RowBox[{"expr_", ",", "varSym_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "beforeAnsatz", ",", "ansatz", ",", "EquationOfConstraint", ",", 
       "ReducedEq", ",", "eqs", ",", "rhsConstants", ",", "rhsSubstitutions", 
       ",", "ibpZeroOperator"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", "\"\<Collecting tensors\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"beforeAnsatz", " ", "=", " ", 
       RowBox[{"List", "@@", 
        RowBox[{"(", 
         RowBox[{"expr", "//", "CollectTensors"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ansatz", "=", 
       RowBox[{"MakeAnsatz", "[", "beforeAnsatz", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Calculating equation\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"EquationOfConstraint", "=", 
       RowBox[{
        RowBox[{"VarD", "[", "varSym", "]"}], "[", "ansatz", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Simplifying equation\>\"", "]"}], ";", "\n", 
      RowBox[{"ReducedEq", "=", 
       RowBox[{"CollectTensors", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"EquationOfConstraint", "//", "ScreenDollarIndices"}], "//",
             "ToCanonical"}], "//", "ContractMetric"}], "//", "SortCovDs"}], "//",
          "Simplify"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Solving equation\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eqs", "=", 
       RowBox[{
        RowBox[{"SolveConstants", "[", 
         RowBox[{
          RowBox[{"ReducedEq", "==", "0"}], ",", 
          RowBox[{"!", 
           RowBox[{"{", 
            RowBox[{
            "hbar", ",", "hbar2", ",", "\[Kappa]", ",", "\[Kappa]2", ",", 
             "\[Epsilon]", ",", "M", ",", "\[Mu]bar2", ",", "G", ",", "A1", 
             ",", "A2", ",", "A3"}], "}"}]}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<substituting solution\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rhsConstants", "=", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"eq", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"s_Symbol", "/;", 
               RowBox[{"StringMatchQ", "[", 
                RowBox[{
                 RowBox[{"SymbolName", "[", "s", "]"}], ",", 
                 RowBox[{"\"\<C\>\"", "~~", 
                  RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], ",", 
              "Infinity"}], "]"}], "//", "DeleteDuplicates"}], ",", 
           RowBox[{"{", 
            RowBox[{"eq", ",", "eqs"}], "}"}]}], "]"}], "]"}], "//", 
        "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rhsSubstitutions", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Cnum", "->", 
          RowBox[{"-", "1"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"Cnum", ",", "rhsConstants"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ibpZeroOperator", "=", 
       RowBox[{
        RowBox[{"ansatz", "/.", "eqs"}], "/.", "rhsSubstitutions"}]}], ";", 
