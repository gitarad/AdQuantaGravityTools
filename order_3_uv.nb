            "\[Epsilon]", ",", "M", ",", "\[Mu]bar2"}], "}"}]}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rhsConstants", "=", 
