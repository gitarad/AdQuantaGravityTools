Cell[BoxData[{
 RowBox[{
  RowBox[{"perturbationSum", "[", 
   RowBox[{"expr_", ",", "order_", ",", "orderParam_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PerturbFlat", "[", 
      RowBox[{"expr", ",", "i"}], "]"}], 
     RowBox[{
      RowBox[{"orderParam", "^", "i"}], "/", 
      RowBox[{"Factorial", "[", "i", "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "order"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"perturbation", " ", "=", " ", 
  RowBox[{
   RowBox[{"(", 
