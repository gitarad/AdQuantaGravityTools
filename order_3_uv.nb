Cell[BoxData[
 RowBox[{
  RowBox[{"IBPSimplify2", "[", 
   RowBox[{"expr_", ",", "varSym_", ",", "varSym2_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "beforeAnsatz", ",", "ansatz", ",", "EquationOfConstraint", ",", 
      "EquationOfConstraint2", ",", "ReducedEq", ",", "ReducedEq2", ",", 
      "eqs", ",", "rhsConstants", ",", "rhsSubstitutions", ",", 
      "ibpZeroOperator"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"beforeAnsatz", " ", "=", " ", 
      RowBox[{"List", "@@", 
       RowBox[{"(", 
        RowBox[{"expr", "//", "CollectTensors"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ansatz", "=", 
