     "\[IndentingNewLine]", 
     RowBox[{"EquationOfConstraint", "=", 
      RowBox[{
       RowBox[{"VarD", "[", "varSym", "]"}], "[", "ansatz", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"EquationOfConstraint2", "=", 
      RowBox[{
       RowBox[{"VarD", "[", "varSym2", "]"}], "[", "ansatz", "]"}]}], ";", 
     "\n", "     ", 
