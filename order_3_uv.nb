             RowBox[{
              RowBox[{"M", "^", "2"}], 
              RowBox[{
               RowBox[{"\[CapitalPhi]", "[", "]"}], "^", "2"}]}]}], ")"}], 
           "/", "2"}]}], ",", "2", ",", 
         RowBox[{"2", "\[Kappa]"}]}], "]"}], "]"}], "//", "ToFlat"}], "//", 
     "CollectTensors"}], ")"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"-", 
        RowBox[{"Detg", "[", "]"}]}], "]"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"\[CapitalPhi]pert", "[", 
       RowBox[{"LI", "[", "n_", "]"}], "]"}], "->", "0"}]}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"translatedPert", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"perturbation", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"CD", "[", "a_", "]"}], ":>", 
         RowBox[{"PD", "[", "a", "]"}]}], ",", 
        RowBox[{
         RowBox[{"H", "[", 
          RowBox[{
           RowBox[{"LI", "[", "order_", "]"}], ",", "a_", ",", "b_"}], "]"}], 
         ":>", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"order", "==", "1"}], ",", 
           RowBox[{"r", "[", 
            RowBox[{"a", ",", "b"}], "]"}], ",", "0"}], "]"}]}]}], "}"}]}], "/.",
      " ", 
     RowBox[{"{", 
