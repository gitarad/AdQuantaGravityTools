      RowBox[{"CollectTensors", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"EquationOfConstraint", "//", "ScreenDollarIndices"}], "//",
            "ToCanonical"}], "//", "ContractMetric"}], "//", "SortCovDs"}], "//",
         "Simplify"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ReducedEq2", "=", 
      RowBox[{"CollectTensors", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"EquationOfConstraint2", "//", "ScreenDollarIndices"}], "//",
