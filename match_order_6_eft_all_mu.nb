             RowBox[{"RiemannCD", "[", 
              RowBox[{
               RowBox[{"-", "\[Alpha]"}], ",", 
               RowBox[{"-", "\[Beta]"}], ",", 
               RowBox[{"-", "\[Rho]"}], ",", 
               RowBox[{"-", "\[Tau]"}]}], "]"}], 
             RowBox[{"RiemannCD", "[", 
              RowBox[{
              "\[Alpha]", ",", "\[Beta]", ",", "\[Rho]", ",", "\[Tau]"}], 
              "]"}]}], ")"}]}], ",", "2", ",", "\[Kappa]"}], "]"}], "]"}], "//",
        "ToFlat"}], "//", "CollectTensors"}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"-", 
        RowBox[{"Detg", "[", "]"}]}], "]"}], "->", "1"}], "}"}]}], 
