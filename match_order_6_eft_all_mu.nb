Cell[BoxData[{
 RowBox[{
  RowBox[{"IBPSimplify", "[", 
   RowBox[{"expr_", ",", "varSym_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "beforeAnsatz", ",", "ansatz", ",", "EquationOfConstraint", ",", 
      "ReducedEq", ",", "eqs", ",", "rhsConstants", ",", "rhsSubstitutions", 
      ",", "ibpZeroOperator"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<Collecting tensors\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"beforeAnsatz", " ", "=", " ", 
      RowBox[{"List", "@@", 
       RowBox[{"(", 
        RowBox[{"expr", "//", "CollectTensors"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ansatz", "=", 
      RowBox[{"MakeAnsatz", "[", "beforeAnsatz", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Calculating equation\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"EquationOfConstraint", "=", 
      RowBox[{
       RowBox[{"VarD", "[", "varSym", "]"}], "[", "ansatz", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Simplifying equation\>\"", "]"}], ";", "\n", 
     RowBox[{"ReducedEq", "=", 
      RowBox[{"CollectTensors", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"EquationOfConstraint", "//", "ScreenDollarIndices"}], "//",
            "ToCanonical"}], "//", "ContractMetric"}], "//", "SortCovDs"}], "//",
         "Simplify"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Solving equation\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqs", "=", 
      RowBox[{
       RowBox[{"SolveConstants", "[", 
        RowBox[{
         RowBox[{"ReducedEq", "==", "0"}], ",", 
         RowBox[{"!", 
          RowBox[{"{", 
           RowBox[{
           "hbar", ",", "hbar2", ",", "\[Kappa]", ",", "\[Kappa]2", ",", 
            "\[Epsilon]", ",", "M", ",", "\[Mu]bar2", ",", "G", ",", "A1", 
            ",", "A2", ",", "A3"}], "}"}]}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<substituting solution\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rhsConstants", "=", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"eq", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"s_Symbol", "/;", 
              RowBox[{"StringMatchQ", "[", 
               RowBox[{
                RowBox[{"SymbolName", "[", "s", "]"}], ",", 
                RowBox[{"\"\<C\>\"", "~~", 
                 RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], ",", 
             "Infinity"}], "]"}], "//", "DeleteDuplicates"}], ",", 
          RowBox[{"{", 
           RowBox[{"eq", ",", "eqs"}], "}"}]}], "]"}], "]"}], "//", 
       "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rhsSubstitutions", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Cnum", "->", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"Cnum", ",", "rhsConstants"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ibpZeroOperator", "=", 
      RowBox[{
       RowBox[{"ansatz", "/.", "eqs"}], "/.", "rhsSubstitutions"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ibpZeroOperator", "=", 
      RowBox[{"ibpZeroOperator", "/.", 
       RowBox[{
        RowBox[{"s_Symbol", "/;", 
         RowBox[{"StringMatchQ", "[", 
          RowBox[{
           RowBox[{"SymbolName", "[", "s", "]"}], ",", 
           RowBox[{"\"\<C\>\"", "~~", 
            RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], ":>", 
        RowBox[{"-", "1"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"expr", "+", "ibpZeroOperator"}], ")"}], "//", 
      "CollectTensors"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"translatePerturbation", "[", "pert_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"pert", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", "a_", "]"}], ":>", 
          RowBox[{"PD", "[", "a", "]"}]}], ",", 
         RowBox[{
          RowBox[{"H", "[", 
           RowBox[{
            RowBox[{"LI", "[", "order_", "]"}], ",", "a_", ",", "b_"}], "]"}],
           ":>", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"order", "==", "1"}], ",", 
            RowBox[{"r", "[", 
             RowBox[{"a", ",", "b"}], "]"}], ",", "0"}], "]"}]}]}], "}"}]}], "/.",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"s_Symbol", "/;", 
          RowBox[{"StringMatchQ", "[", 
           RowBox[{
            RowBox[{"SymbolName", "[", "s", "]"}], ",", "\"\<\[Tau]*\>\""}], 
           "]"}]}], ":>", 
         RowBox[{"ToExpression", "[", 
          RowBox[{"\"\<d\>\"", "<>", 
           RowBox[{"StringDrop", "[", 
            RowBox[{
             RowBox[{"SymbolName", "[", "s", "]"}], ",", "1"}], "]"}]}], 
          "]"}]}], ",", 
        RowBox[{"\[Alpha]", "->", "a"}], ",", 
        RowBox[{"\[Beta]", "->", "b"}], ",", 
        RowBox[{"\[Rho]", "->", "c"}], ",", 
        RowBox[{"\[Tau]", "->", "d"}]}], "}"}]}], "//", "CollectTensors"}], "//",
     "ScreenDollarIndices"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.980495848185919*^9, 3.980495905151451*^9}, {
  3.980495949752337*^9, 3.980496041358467*^9}, {3.98049650718092*^9, 
  3.9804965313899803`*^9}, {3.980496564051548*^9, 3.980496583805485*^9}, {
  3.980504562480925*^9, 3.9805045633600636`*^9}, {3.980505765965231*^9, 
  3.980505766935021*^9}, {3.982226463438383*^9, 3.982226463797369*^9}, {
  3.982309018536658*^9, 3.9823090198764114`*^9}, {3.982315362092465*^9, 
  3.982315366938711*^9}, {3.98231584096908*^9, 3.98231592753058*^9}, {
  3.982315966833437*^9, 3.98231597681794*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"475b4562-5525-0c4c-b8d4-a784841514a0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"perturbationSum", "[", 
   RowBox[{"expr_", ",", "order_", ",", "orderParam_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
