Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TracePower", "[", 
    RowBox[{"tensor_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "inds", "}"}], ",", 
     RowBox[{
      RowBox[{"inds", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"DummyIn", "[", "TangentM4", "]"}], "&"}], ",", "n"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Times", "@@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"tensor", "[", 
          RowBox[{
           RowBox[{"inds", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"inds", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"i", ",", "n"}], "]"}], "+", "1"}], "]"}], "]"}]}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"TracePower", "[", 
      RowBox[{"tensor_", ",", "n_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"C1", "^", "n"}], "+", 
      RowBox[{"C2", "^", "n"}], "+", 
      RowBox[{"C3", "^", "n"}], "+", 
      RowBox[{"C4", "^", "n"}]}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TracePowerPowered", "[", 
    RowBox[{"tensor_", ",", "n_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"Times", "@@", 
    RowBox[{"Table", "[", 
