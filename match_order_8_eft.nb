Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TracePower", "[", 
    RowBox[{"tensor_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "inds", "}"}], ",", 
     RowBox[{
      RowBox[{"inds", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"DummyIn", "[", "TangentM4", "]"}], "&"}], ",", "n"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Times", "@@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"tensor", "[", 
          RowBox[{
           RowBox[{"inds", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"inds", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"i", ",", "n"}], "]"}], "+", "1"}], "]"}], "]"}]}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"TracePower", "[", 
      RowBox[{"tensor_", ",", "n_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"C1", "^", "n"}], "+", 
      RowBox[{"C2", "^", "n"}], "+", 
      RowBox[{"C3", "^", "n"}], "+", 
      RowBox[{"C4", "^", "n"}]}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TracePowerPowered", "[", 
    RowBox[{"tensor_", ",", "n_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"Times", "@@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"TracePower", "[", 
       RowBox[{"tensor", ",", "n"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "k"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EvanescentTrace", "[", 
   RowBox[{"n_", ",", "tensor_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"TracePower", "[", 
      RowBox[{"tensor", ",", "n"}], "]"}]}], " ", "+", 
    RowBox[{
     RowBox[{"TracePower", "[", 
      RowBox[{"tensor", ",", 
       RowBox[{"n", "-", "1"}]}], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"TracePower", "[", 
       RowBox[{"tensor", ",", "1"}], "]"}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"TracePower", "[", 
      RowBox[{"tensor", ",", 
       RowBox[{"n", "-", "2"}]}], "]"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"TracePowerPowered", "[", 
          RowBox[{"tensor", ",", "1", ",", "2"}], "]"}]}], "+", 
        RowBox[{"TracePower", "[", 
         RowBox[{"tensor", ",", "2"}], "]"}]}], ")"}], "/", "2"}]}], "+", 
    RowBox[{
     RowBox[{"TracePower", "[", 
      RowBox[{"tensor", ",", 
       RowBox[{"n", "-", "3"}]}], "]"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"TracePowerPowered", "[", 
         RowBox[{"tensor", ",", "1", ",", "3"}], "]"}], "-", 
        RowBox[{"3", " ", 
         RowBox[{"TracePower", "[", 
          RowBox[{"tensor", ",", "1"}], "]"}], " ", 
         RowBox[{"TracePower", "[", 
          RowBox[{"tensor", ",", "2"}], "]"}]}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"TracePower", "[", 
          RowBox[{"tensor", ",", "3"}], "]"}]}]}], ")"}], "/", "6"}]}], "-", 
    RowBox[{
     RowBox[{"TracePower", "[", 
      RowBox[{"tensor", ",", 
       RowBox[{"n", "-", "4"}]}], "]"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"TracePowerPowered", "[", 
         RowBox[{"tensor", ",", "1", ",", "4"}], "]"}], "-", 
        RowBox[{"6", " ", 
         RowBox[{"TracePowerPowered", "[", 
          RowBox[{"tensor", ",", "1", ",", "2"}], " ", "]"}], 
         RowBox[{"TracePower", "[", 
          RowBox[{"tensor", ",", "2"}], "]"}]}], "+", 
        RowBox[{"3", " ", 
         RowBox[{"TracePowerPowered", "[", 
          RowBox[{"tensor", ",", "2", ",", "2"}], "]"}]}], "+", 
        RowBox[{"8", " ", 
         RowBox[{"TracePower", "[", 
          RowBox[{"tensor", ",", "1"}], "]"}], " ", 
         RowBox[{"TracePower", "[", 
          RowBox[{"tensor", ",", "3"}], "]"}]}], "-", 
        RowBox[{"6", " ", 
         RowBox[{"TracePower", "[", 
          RowBox[{"tensor", ",", "4"}], "]"}]}]}], ")"}], "/", "24"}]}]}], 
   "\n", ")"}]}]}], "Input",
