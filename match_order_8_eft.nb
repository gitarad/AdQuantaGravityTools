Cell[BoxData[
 RowBox[{
  RowBox[{"riemannSquared", " ", "=", " ", 
   RowBox[{"translatePerturbation", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"ExpandPerturbation", "[", 
         RowBox[{"perturbationSum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"-", 
              RowBox[{"Detg", "[", "]"}]}], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"RiemannCD", "[", 
               RowBox[{
                RowBox[{"-", "\[Alpha]"}], ",", 
                RowBox[{"-", "\[Beta]"}], ",", 
                RowBox[{"-", "\[Rho]"}], ",", 
                RowBox[{"-", "\[Tau]"}]}], "]"}], 
              RowBox[{"RiemannCD", "[", 
               RowBox[{
               "\[Alpha]", ",", "\[Beta]", ",", "\[Rho]", ",", "\[Tau]"}], 
               "]"}]}], ")"}]}], ",", 
           RowBox[{"eftOrder", "-", "4"}], ",", "\[Kappa]"}], "]"}], "]"}], "//",
         "ToFlat"}], "//", "CollectTensors"}], ")"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"-", 
         RowBox[{"Detg", "[", "]"}]}], "]"}], "->", "1"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9863669360142155`*^9, 3.9863669625030537`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"cc2728cc-1442-1141-8964-f2c9347c8d2b"],

