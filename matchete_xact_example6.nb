Cell[BoxData[
 RowBox[{"ricciSquared", " ", "=", " ", 
  RowBox[{"IBPSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"translatePerturbation", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"ExpandPerturbation", "[", 
           RowBox[{"perturbationSum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{"-", 
                RowBox[{"Detg", "[", "]"}]}], "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"RicciCD", "[", 
                 RowBox[{
                  RowBox[{"-", "\[Alpha]"}], ",", 
                  RowBox[{"-", "\[Beta]"}]}], "]"}], 
                RowBox[{"RicciCD", "[", 
                 RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}]}], ")"}]}], ",", 
             "2", ",", "\[Kappa]"}], "]"}], "]"}], "//", "ToFlat"}], "//", 
         "CollectTensors"}], ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"-", 
           RowBox[{"Detg", "[", "]"}]}], "]"}], "->", "1"}], "}"}]}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{"\[Kappa]", "->", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"12", "/", "hbar2"}], "]"}], "/", "M"}]}], "}"}]}], ",", 
    RowBox[{"R", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}]}], "]"}]}]], "Input",
