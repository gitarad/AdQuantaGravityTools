Cell[BoxData[
 RowBox[{
  RowBox[{"LEFTxAct", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"MatcheteToXAct", "[", 
      RowBox[{"LEFT0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"h", "->", "r"}], "}"}]}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Mu]bar2", "->", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "3"}], "/", "2"}], "]"}], 
         RowBox[{"M", "^", "2"}]}]}], ",", 
       RowBox[{
        RowBox[{"1", "/", "\[Epsilon]"}], "->", "0"}]}], "}"}]}], "//", 
    "CollectTensors"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9798930954359303`*^9, 3.979893107664678*^9}, {
   3.979893274096716*^9, 3.979893275744325*^9}, {3.979893457340536*^9, 
   3.9798934609678574`*^9}, {3.9804097531527843`*^9, 3.9804097744135647`*^9}, 
   3.980414953423801*^9},
