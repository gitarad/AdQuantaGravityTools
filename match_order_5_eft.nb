 RowBox[{"translatedPert", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"perturbation", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"CD", "[", "a_", "]"}], ":>", 
        RowBox[{"PD", "[", "a", "]"}]}], ",", 
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{
          RowBox[{"LI", "[", "order_", "]"}], ",", "a_", ",", "b_"}], "]"}], ":>", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"order", "==", "1"}], ",", 
          RowBox[{"r", "[", 
           RowBox[{"a", ",", "b"}], "]"}], ",", "0"}], "]"}]}]}], "}"}]}], "/.",
