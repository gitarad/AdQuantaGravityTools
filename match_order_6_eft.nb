          RowBox[{"H", "[", 
           RowBox[{
            RowBox[{"LI", "[", "order_", "]"}], ",", "a_", ",", "b_"}], "]"}],
           ":>", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"order", "==", "1"}], ",", 
            RowBox[{"r", "[", 
             RowBox[{"a", ",", "b"}], "]"}], ",", "0"}], "]"}]}]}], "}"}]}], "/.",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"s_Symbol", "/;", 
          RowBox[{"StringMatchQ", "[", 
           RowBox[{
            RowBox[{"SymbolName", "[", "s", "]"}], ",", "\"\<\[Tau]*\>\""}], 
           "]"}]}], ":>", 
         RowBox[{"ToExpression", "[", 
          RowBox[{"\"\<d\>\"", "<>", 
           RowBox[{"StringDrop", "[", 
            RowBox[{
             RowBox[{"SymbolName", "[", "s", "]"}], ",", "1"}], "]"}]}], 
          "]"}]}], ",", 
        RowBox[{"\[Alpha]", "->", "a"}], ",", 
        RowBox[{"\[Beta]", "->", "b"}], ",", 
        RowBox[{"\[Rho]", "->", "c"}], ",", 
