 RowBox[{
  RowBox[{
   RowBox[{"translatePerturbation", "[", "pert_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"pert", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
