Cell[BoxData[{
 RowBox[{
  RowBox[{"perturbationSum", "[", 
   RowBox[{"expr_", ",", "order_", ",", "orderParam_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PerturbFlat", "[", 
      RowBox[{"expr", ",", "i"}], "]"}], 
     RowBox[{
      RowBox[{"orderParam", "^", "i"}], "/", 
      RowBox[{"Factorial", "[", "i", "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "order"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"perturbation", " ", "=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"ExpandPerturbation", "[", 
       RowBox[{"perturbationSum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"-", 
            RowBox[{"Detg", "[", "]"}]}], "]"}], 
          RowBox[{"RicciScalarCD", "[", "]"}]}], ",", "4", ",", "\[Kappa]"}], 
        "]"}], "]"}], "//", "ToFlat"}], "//", "CollectTensors"}], ")"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"-", 
       RowBox[{"Detg", "[", "]"}]}], "]"}], "->", "1"}], "}"}]}]}]}], "Input",\

