Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"IBPSimplify", "[", 
    RowBox[{"expr_", ",", "varSym_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "beforeAnsatz", ",", "ansatz", ",", "EquationOfConstraint", ",", 
       "ReducedEq", ",", "eqs", ",", "rhsConstants", ",", "rhsSubstitutions", 
       ",", "ibpZeroOperator"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"beforeAnsatz", " ", "=", " ", 
       RowBox[{"List", "@@", 
        RowBox[{"(", 
         RowBox[{"expr", "//", "CollectTensors"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ansatz", "=", 
       RowBox[{"MakeAnsatz", "[", "beforeAnsatz", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"EquationOfConstraint", "=", 
       RowBox[{
        RowBox[{"VarD", "[", "varSym", "]"}], "[", "ansatz", "]"}]}], ";", 
      "\n", 
